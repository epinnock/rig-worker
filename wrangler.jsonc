// Self-host: `npx wrangler deploy` (creates the R2 bucket on first deploy), then `npx wrangler secret put RIG_TOKEN`.
// The public demo is the `demo` environment: `npx wrangler deploy --env demo`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rig-worker",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "limits": { "cpu_ms": 300000 }, // bind on a big mesh can take a minute of CPU (Workers Paid plan)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "rig-worker-files" }],
  "observability": { "enabled": true },

  "env": {
    "demo": {
      "name": "rig-worker-demo",
      "limits": { "cpu_ms": 60000 },
      "vars": { "DEMO": "1" },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "rig-worker-demo-files" }],
      "ratelimits": [
        { "name": "RL", "namespace_id": "41001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_HEAVY", "namespace_id": "41002", "simple": { "limit": 6, "period": 60 } },
        { "name": "RL_GLOBAL", "namespace_id": "41003", "simple": { "limit": 12, "period": 60 } }
      ]
    }
  }
}
